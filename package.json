{
  "name": "realm-of-darkness",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:discord": "pnpm --filter @realm/discord dev",
    "dev:api": "turbo run dev --filter=@realm/api",
    "build": "turbo run build",
    "build:discord": "turbo run build --filter=@realm/discord",
    "build:api": "turbo run build --filter=@realm/api",
    "build:types": "tsc -b",
    "discord:emoji:sync": "turbo run emoji:sync --filter=@realm/discord",
    "db:migrate": "turbo run migrate --filter=@realm/database",
    "db:generate": "turbo run generate --filter=@realm/database",
    "db:studio": "turbo run studio --filter=@realm/database",
    "db:reset": "turbo run reset --filter=@realm/database",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "node scripts/clean.mjs",
    "clean:dist": "turbo run clean",
    "clean-build": "pnpm clean && pnpm install && pnpm build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css,scss}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.11.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
