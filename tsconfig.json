{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "composite": true,
    "incremental": true,
    "removeComments": false,
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "paths": {
      "@realm/core": ["./packages/core/src/index.ts"],
      "@realm/core/*": ["./packages/core/src/*"],
      "@realm/database": ["./packages/database/src/index.ts"],
      "@realm/database/*": ["./packages/database/src/*"],
      "@realm/content": ["./packages/content/src/index.ts"],
      "@realm/content/*": ["./packages/content/src/*"],
      "@realm/logger": ["./packages/logger/src/index.ts"],
      "@realm/logger/*": ["./packages/logger/src/*"],
      "@realm/repositories": ["./packages/repositories/src/index.ts"],
      "@realm/repositories/*": ["./packages/repositories/src/*"],
      "@realm/events": ["./packages/events/src/index.ts"],
      "@realm/events/*": ["./packages/events/src/*"],
      "@realm/assets": ["./packages/assets/src/index.ts"],
      "@realm/assets/*": ["./packages/assets/src/*"]
    }
  },
  "exclude": [".agents", "node_modules", "dist"],
  "files": [],
  "references": [
    { "path": "packages/common/tsconfig.build.json" },
    { "path": "packages/core" },
    { "path": "packages/database" },
    { "path": "packages/content" },
    { "path": "apps/api" },
    { "path": "apps/discord" },
    { "path": "packages/logger" },
    { "path": "packages/repositories" },
    { "path": "packages/events" },
    { "path": "packages/assets" }
  ]
}
