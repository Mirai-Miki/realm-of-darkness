{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "experimentalDecorators": true,
    "typeRoots": [
      "../../node_modules/@types",
      "node_modules/@types",
      "src/types"
    ],
    "types": ["node", "jest"],
    "paths": {
      "features": ["./src/features/index.ts"],
      "features/*": ["./src/features/*"],
      "framework": ["./src/framework/index.ts"],
      "framework/*": ["./src/framework/*"],
      "utilities": ["./src/utilities/index.ts"],
      "utilities/*": ["./src/utilities/*"],
      "types": ["./src/types/index.ts"],
      "types/*": ["./src/types/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../packages/common/tsconfig.build.json" },
    { "path": "../../packages/content/tsconfig.build.json" },
    { "path": "../../packages/assets/tsconfig.build.json" },
    { "path": "../../packages/logger/tsconfig.build.json" },
    { "path": "../../packages/core/tsconfig.build.json" },
    { "path": "../../packages/repositories/tsconfig.build.json" },
    { "path": "../../packages/database/tsconfig.build.json" }
  ]
}
